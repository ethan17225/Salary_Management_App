# Switch between local Mac Vision AI (Metal GPU via Ollama) and self-contained Docker CPU OCR:
#   local  -> Ollama running on your Mac (fast Metal GPU, best for handwritten cheques)
#   docker -> 100% inside the backend container (RapidOCR + Qwen2.5-0.5B CPU)
# After editing, apply with: docker compose up -d backend
OCR_RUNTIME=docker

# Local Mac Ollama settings (used when OCR_RUNTIME=local)
VISION_API_BASE_URL=http://host.docker.internal:11434/v1
VISION_MODEL_NAME=qwen3-vl:4b-instruct
VISION_API_KEY=ollama
